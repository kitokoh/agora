{
  "name": "@agora/db",
  "version": "0.1.0",
  "private": true,
  "description": "Agora database layer — Prisma schema (schema-per-context), migrations, seeds, typed client.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma-client": {
      "types": "./generated/prisma-client.d.ts",
      "default": "./generated/prisma-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "validate": "prisma validate",
    "studio": "prisma studio",
    "seed": "tsx src/seed.ts"
  },
  "prisma": {
    "seed": "pnpm tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
