{
  "name": "@agora/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint / Prettier / TypeScript presets for the Agora monorepo.",
  "license": "UNLICENSED",
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./prettier": "./prettier/index.json",
    "./tsconfig/*": "./tsconfig/*.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node -e \"console.log('@agora/config: nothing to build (json/mjs presets only)')\""
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.9.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "typescript-eslint": "^8.5.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
