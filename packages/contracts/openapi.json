                "example": "01961e78-4d99-7c20-8000-000000000000"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "mfaRequired": {
                "type": "boolean"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "email",
              "mfaRequired",
              "roles"
            ]
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "tokenType",
          "user"
        ]
      },
