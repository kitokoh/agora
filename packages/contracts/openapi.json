      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "RS256 JWT, 15 min TTL"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token, 30 d TTL, rotated on use"
