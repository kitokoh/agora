# Agora app environment (copy to .env)
# API base URL used by the edge middleware to fetch the JWKS (server-side).
AGORA_API_URL=http://localhost:4000
# Public API base URL used by client-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Buyer web app URL (used by dashboard/admin guards to bounce to login).
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
