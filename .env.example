# ============================================================================
# Agora — environment template
# Copy to `.env` and fill in. NEVER commit real secrets.
# Production secrets live in AWS Secrets Manager (see docs/security.md).
# ============================================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
APP_ENV=local

# --- API security (#18) ---
# Comma-separated CORS allowlist; empty = same-origin only
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Global per-IP rate limit (requests/minute)
RATE_LIMIT_MAX=300

# --- PostgreSQL ---
DATABASE_URL=postgresql://agora:agora@localhost:5432/agora?schema=public

# --- Redis (queues + cache) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=agora-master-key

# --- Object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agora-media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=agora-secret
S3_FORCE_PATH_STYLE=true
CDN_URL=http://localhost:9000

# --- Identity ---
JWT_PUBLIC_KEY=<generate: openssl genpkey -algorithm RSA -out jwt_private.pem; openssl rsa -pubout>
JWT_PRIVATE_KEY=<see above>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MFA_ISSUER=Agora

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
PLATFORM_FEE_PERCENT=5.0

# --- Email / SMS ---
RESEND_API_KEY=re_xxx
SMS_PROVIDER_API_KEY=xxx
NOTIFICATIONS_FROM=no-reply@agora.market

# --- Observability ---
SENTRY_DSN=https://xxx@o.ingest.sentry.io/xxx
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:9000
