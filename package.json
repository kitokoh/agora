{
  "name": "agora",
  "version": "0.1.0",
  "private": true,
  "description": "Agora \u2014 industrial-grade marketplace SaaS for boutiques and independent sellers.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "db:generate": "pnpm --filter @agora/db generate",
    "db:migrate": "pnpm --filter @agora/db migrate",
    "db:studio": "pnpm --filter @agora/db studio",
    "postinstall": "pnpm --filter @agora/db generate"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@agora/config": "workspace:*",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "sharp": "^0.35.0",
      "postcss": "^8.5.12"
    }
  }
}
